<?xml version="1.0" encoding="utf-8"?>
<!-- App icon background: the app's indigo -> violet gradient, with two soft glows for depth.
     Canvas is 108x108; launchers crop it to a circle/squircle showing roughly the middle 72. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF4F46E5"
                android:endColor="#FF7C3AED" />
        </aapt:attr>
    </path>
    <!-- Light glow, top left -->
    <path
        android:fillColor="#1AFFFFFF"
        android:pathData="M30,30m-38,0a38,38 0,1 1,76 0a38,38 0,1 1,-76 0" />
    <!-- Darker glow, bottom right -->
    <path
        android:fillColor="#1A1E1B4B"
        android:pathData="M86,88m-30,0a30,30 0,1 1,60 0a30,30 0,1 1,-60 0" />
</vector>
