<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to record the user's voice. Android also asks the user at runtime. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Needed to call the backend. Unlike the microphone, Android grants this without asking. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets us check "is the phone online?" before recording. Also granted without asking. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 11+ hides other apps by default. This lets us find the text-to-speech engine... -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- ...and the UPI apps we can open (keep in sync with UpiApps.KNOWN). -->
        <package android:name="com.google.android.apps.nbu.paisa.user" />
        <package android:name="com.phonepe.app" />
        <package android:name="net.one97.paytm" />
        <package android:name="in.org.npci.upiapp" />
        <package android:name="com.dreamplug.androidapp" />
        <package android:name="com.mobikwik_new" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoicePay">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.VoicePay"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>