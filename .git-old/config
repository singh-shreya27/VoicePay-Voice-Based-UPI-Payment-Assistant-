	url = https://github.com/codewithsuvansh/Voice-Assisted-Payment-System.git
	fetch = +refs/heads/*:refs/remotes/upstream/*
[branch "main"]
	remote = origin
	vscode-merge-base = origin/main
	merge = refs/heads/main
