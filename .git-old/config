	vscode-merge-base = origin/main
	remote = upstream
	merge = refs/heads/feat/android-app
[remote "origin"]
	url = https://github.com/singh-shreya27/VoicePay-Voice-Based-UPI-Payment-Assistant-.git
	fetch = +refs/heads/*:refs/remotes/origin/*
